# URL pública usada em canonical, sitemap e Open Graph
NEXT_PUBLIC_SITE_URL=https://www.exemplo.com.br

# MongoDB Atlas (estoque, fotos, contatos e login do painel). Sem isto o site usa o estoque de demonstração.
MONGODB_URI=mongodb+srv://USUARIO:SENHA@CLUSTER.mongodb.net/inga?retryWrites=true&w=majority

# Segredo que assina o cookie de login do painel (mínimo 32 caracteres, aleatório). Gere com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
ADMIN_SESSION_SECRET=

# Só defina 1 no ambiente de PRODUÇÃO do domínio oficial. Sem isto o site se declara noindex (robots.txt + meta).
ALLOW_INDEXING=
